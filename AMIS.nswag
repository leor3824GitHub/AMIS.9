    "fromDocument": {
      "json": "{\r\n  \"openapi\": \"3.0.1\",\r\n  \"info\": {\r\n    \"title\": \"AMIS.WebApi\",\r\n    \"description\": \"AMIS.9 with Vertical Slice Architecture!\",\r\n    \"contact\": {\r\n      \"name\": \"Roel Caperig\",\r\n      \"email\": \"leor3824@yahoo.com\"\r\n    },\r\n    \"version\": \"1\"\r\n  },\r\n  \"paths\": {\r\n    \"/api/v{version}/inventories/acceptances/acceptances/{acceptanceId}/items\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"acceptanceItems\"\r\n        ],\r\n        \"summary\": \"Add item to acceptance\",\r\n        \"description\": \"Adds a new item to an acceptance\",\r\n        \"operationId\": \"AddAcceptanceItem\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"version\",\r\n            \"in\": \"path\",\r\n            \"description\": \"The requested API version\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"default\": \"1\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"acceptanceId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/AddAcceptanceItemCommand\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/api/v{version}/inventories/acceptances/acceptances/{acceptanceId}/items/{itemId}\": {\r\n      \"put\": {\r\n        \"tags\": [\r\n          \"acceptanceItems\"\r\n        ],\r\n        \"summary\": \"Update item in acceptance\",\r\n    