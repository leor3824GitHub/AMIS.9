n          {\r\n            \"name\": \"id\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/AcceptanceResponse\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      },\r\n      \"put\": {\r\n        \"tags\": [\r\n          \"acceptances\"\r\n        ],\r\n        \"summary\": \"update a acceptance\",\r\n        \"description\": \"update a acceptance\",\r\n        \"operationId\": \"UpdateAcceptanceEndpoint\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"version\",\r\n            \"in\": \"path\",\r\n            \"description\": \"The requested API version\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"default\": \"1\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"id\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/UpdateAcceptanceCommand\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/UpdateAcceptanceResponse\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/api/v{version}/inventories/acceptances/search\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"acceptances\"\r\n        ],\r\n        \"summary\": \"Gets a list of acceptances\",\r\n        \"description\": \"Gets a list of acceptances with pagination and filtering support\",\r\n        \"operationId\": \"SearchAcceptancesEndpoint\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"version\",\r\n            \"in\": \"path\",\r\n            \"description\": \"The requested API version\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"default\": \"1\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/SearchAcceptancesCommand\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/AcceptanceResponsePagedList\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/api/v{version}/inventories/acceptances/{id}/post\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"acceptances\"\r\n        ],\r\n        \"summary\": \"post an acceptance\",\r\n        \"description\": \"mark an acceptance as posted\",\r\n        \"operationId\": \"PostAcceptanceEndpoint\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"version\",\r\n            \"in\": \"path\",\r\n            \"description\": \"The requested API version\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"default\": \"1\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"id\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/PostAcceptanceResponse\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/api/v{version}/inventories/acceptances/{acceptanceId}/link-inspection/{inspectionId}\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"acceptances\"\r\n        ],\r\n        \"summary\": \"link acceptance to inspection\",\r\n        \"description\": \"link an acceptance record to an approved inspection\",\r\n        \"operationId\": \"LinkAcceptanceInspectionEndpoint\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"version\",\r\n            \"in\": \"path\",\r\n            \"description\": \"The requested API version\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"default\": \"1\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"acceptanceId\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"inspectionId\",\r\n           