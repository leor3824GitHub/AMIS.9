true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"default\": \"1\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"id\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"requestBody\": {\r\n          \"content\": {\r\n            \"application/json\": {\r\n              \"schema\": {\r\n                \"$ref\": \"#/components/schemas/IssuePhysicalAssetCommand\"\r\n              }\r\n            }\r\n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/IssuePhysicalAssetResponse\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/api/v{version}/inventories/physicalAssets/{id}/return\": {\r\n      \"put\": {\r\n        \"tags\": [\r\n          \"physicalAssets\"\r\n        ],\r\n        \"summary\": \"Returns a physical asset from an employee\",\r\n        \"description\": \"Records the return of a physical asset from an employee\",\r\n        \"operationId\": \"ReturnPhysicalAssetEndpoint\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"version\",\r\n            \"in\": \"path\",\r\n            \"description\": \"The requested API version\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"default\": \"1\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"id\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\