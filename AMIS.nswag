n          },\r\n          \"required\": true\r\n        },\r\n        \"responses\": {\r\n          \"200\": {\r\n            \"description\": \"OK\",\r\n            \"content\": {\r\n              \"application/json\": {\r\n                \"schema\": {\r\n                  \"$ref\": \"#/components/schemas/UpdateAssetClassificationRuleResponse\"\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      },\r\n      \"delete\": {\r\n        \"tags\": [\r\n          \"assetClassificationRules\"\r\n        ],\r\n        \"summary\": \"Deletes an asset classification rule\",\r\n        \"description\": \"Deletes an asset classification rule by its ID\",\r\n        \"operationId\": \"DeleteAssetClassificationRuleEndpoint\",\r\n        \"parameters\": [\r\n          {\r\n            \"name\": \"version\",\r\n            \"in\": \"path\",\r\n            \"description\": \"The requested API version\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"default\": \"1\"\r\n            }\r\n          },\r\n          {\r\n            \"name\": \"id\",\r\n            \"in\": \"path\",\r\n            \"required\": true,\r\n            \"schema\": {\r\n              \"type\": \"string\",\r\n              \"format\": \"uuid\"\r\n            }\r\n          }\r\n        ],\r\n        \"responses\": {\r\n          \"204\": {\r\n            \"description\": \"No Content\"\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"/api/v{version}/inventories/assetClassificationRules/search\": {\r\n      \"post\": {\r\n        \"tags\": [\r\n          \"assetClassificationRules\"\r\n        ],\r\n        \"summary\": \"Gets a list of asset classification rules\",\r\n        \"description\": \"Gets a list of asset classification rules with pagination and filtering support\",\r\n        \"operationId\": \"SearchAssetClassificationRulesEndpoint\",\r\n        \"parameters\": [\r\n      