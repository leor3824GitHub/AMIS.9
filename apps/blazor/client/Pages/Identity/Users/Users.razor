@page "/identity/users"

<PageHeader Title="Users" Header="Users" SubHeader="Manage Users." />

<EntityTable TEntity="UserDetail" TId="Guid" TRequest="RegisterUserCommand" Context="@Context">
    <ExtraActions>
        <MudMenuItem OnClick="(() => ViewProfile(context.Id))">View Profile</MudMenuItem>
        @if (_canViewRoles)
        {
            <MudMenuItem OnClick="(() => ManageRoles(context.Id))">Manage Roles</MudMenuItem>
        }
        @if (_canViewAuditTrails)
        {
            <MudMenuItem OnClick="(() => ViewAuditTrails(context.Id))">View Audit Trails</MudMenuItem>
        }
    </ExtraActions>

    <EditFormContent>
        <MudItem xs="12" md="6">
            <MudTextField For="@(() => context.RequestModel.UserName)" @bind-Value="context.RequestModel.UserName" Label="User Name" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField For="@(() => context.RequestModel.FirstName)" @bind-Value="context.RequestModel.FirstName" Label="First Name" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField For="@(() => context.RequestModel.LastName)" @bind-Value="context.RequestModel.LastName" Label="Last Name" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField For="@(() => context.RequestModel.Email)" InputType="InputType.Email" @bind-Value="context.RequestModel.Email"
                Label="Email" />
        </MudItem>
        <MudItem xs="12" md="12">
            <MudTextField For="@(() => context.RequestModel.PhoneNumber)" @bind-Value="context.RequestModel.PhoneNumber"
                Label="Phone Number" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField For="@(() => context.RequestModel.Password)" @bind-Value="context.RequestModel.Password" Label="Password"
                InputType="@_passwordInput" Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon"
                OnAdornmentClick="TogglePasswordVisibility" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField For="@(() => context.RequestModel.ConfirmPassword)" @bind-Value="context.RequestModel.ConfirmPassword"
                Label="Confirm Password" InputType="InputType.Password" />
        </MudItem>
    </EditFormContent>

</EntityTable>