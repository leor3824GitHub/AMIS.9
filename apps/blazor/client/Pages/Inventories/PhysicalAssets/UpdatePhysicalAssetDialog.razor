@namespace AMIS.Blazor.Client.Pages.Inventories.PhysicalAssets

@if (Model != null)
{
<EditForm Model="@Model" OnValidSubmit="OnValidSubmit">
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">Manage Asset Hierarchy</MudText>
        </TitleContent>
        <DialogContent>
            @if (_asset != null)
            {
                <DataAnnotationsValidator />
                <ValidationSummary />
                <MudStack Spacing="3">
                    <!-- Asset Info Section -->
                    <MudCard Elevation="0" Class="pa-4" Style="background-color: rgba(63, 81, 181, 0.05);">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                            Asset Information
                        </MudText>
                        <MudGrid Spacing="1">
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2"><strong>Property Code:</strong> @_asset?.PropertyCode</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2"><strong>Serial Number:</strong> @(_asset?.SerialNumber ?? "N/A")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2"><strong>Model Number:</strong> @(_asset?.ModelNumber ?? "N/A")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.body2"><strong>Classification:</strong> @_asset?.Classification</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Typo="Typo.body2"><strong>Quantity:</strong> -</MudText>
                            </MudItem>
                            <MudItem xs="12">

                            </MudItem>
                        </MudGrid>
                    </MudCard>

                    <!-- Financial Information Section -->
                    @if (_asset?.Classification.ToString() == "PropertyPlantEquipment" || _asset?.Classification.ToString() == "2")
                    {
                        <MudCard Elevation="0" Class="pa-4" Style="background-color: rgba(76, 175, 80, 0.05);">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-1" />
                                Financial Information (PPE)
                            </MudText>
                            <MudGrid Spacing="1">
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.body2"><strong>Acquisition Cost:</strong> ₱@_asset?.AcquisitionCost.ToString("N2")</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.body2"><strong>Accumulated Depreciation:</strong> ₱@_asset?.AccumulatedDepreciation.ToString("N2")</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.body2"><strong>Book Value:</strong> ₱@_asset?.BookValue.ToString("N2")</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.body2"><strong>RCA Account Code:</strong> @(_asset?.RcaAccountCode ?? "N/A")</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudCard>
                    }

                    <!-- Parent Asset Section -->
                    <MudCard Elevation="0" Class="pa-4" Style="background-color: rgba(156, 39, 176, 0.05);">
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">
                            <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Size="Size.Small" Class="mr-1" />
                            Asset Hierarchy
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mb-2">Update parent asset to modify asset hierarchy</MudText>
                        <MudAutocomplete T="PhysicalAssetResponse" Label="Parent Asset" @bind-Value="_selectedParentAsset"
                            SearchFunc="@SearchParentAssets" ToStringFunc="@(p => p == null ? string.Empty : p.PropertyCode)"
                            Clearable="true" ResetValueOnEmptyText="true" Variant="Variant.Outlined"
                            Dense="false" Style="width: 100%;" />
                        @if (_asset.ParentAssetId.HasValue)
                        {
                            <MudText Typo="Typo.caption" Class="mt-2">
                                <strong>Current Parent:</strong> @_asset.ParentAssetId
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">
                                This asset has no parent asset assigned.
                            </MudText>
                        }
                    </MudCard>
                </MudStack>
            }
            else
            {
                <MudProgressLinear Indeterminate="true" />
            }
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                Disabled="@(_loading || _asset == null)">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Update
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel" Disabled="@_loading">Cancel
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>
}

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid AssetId { get; set; }

    [Inject]
    private IApiClient ApiClient { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    private UpdatePhysicalAssetCommand? Model;
    private PhysicalAssetResponse? _asset;
    private PhysicalAssetResponse? _selectedParentAsset;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _asset = await ApiClient.GetPhysicalAssetEndpointAsync("1", AssetId);
            if (_asset != null)
            {
                Model = new UpdatePhysicalAssetCommand
                {
                    Id = AssetId
                };
                // Load parent asset if it exists
                if (_asset.ParentAssetId.HasValue)
                {
                    try
                    {
                        _selectedParentAsset = await ApiClient.GetPhysicalAssetEndpointAsync("1", _asset.ParentAssetId.Value);
                    }
                    catch
                    {
                        // Parent asset may have been deleted, continue without it
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar?.Add($"Error loading asset: {ex.Message}", Severity.Error);
            MudDialog?.Cancel();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnValidSubmit()
    {
        if (Model == null)
        {
            Snackbar?.Add("Model not initialized.", Severity.Error);
            return;
        }

        // Validate: Asset cannot be its own parent
        if (_selectedParentAsset?.Id == AssetId)
        {
            Snackbar?.Add("An asset cannot be assigned as its own parent.", Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            // Only update if parent asset changed
            if (_selectedParentAsset?.Id != _asset?.ParentAssetId)
            {
                // Create the command with parent asset ID
                var updateCommand = new UpdatePhysicalAssetCommand
                {
                    Id = AssetId,
                    Condition = null,
                    ParentAssetId = _selectedParentAsset?.Id
                };
                await ApiClient.UpdatePhysicalAssetEndpointAsync("1", AssetId, updateCommand);
                Snackbar?.Add("Asset hierarchy updated successfully.", Severity.Success);
            }
            else
            {
                Snackbar?.Add("No changes made.", Severity.Info);
            }
            MudDialog?.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar?.Add($"Error updating asset hierarchy: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cancel() => MudDialog?.Cancel();

    private async Task<IEnumerable<PhysicalAssetResponse>> SearchParentAssets(string value, CancellationToken cancellationToken = default)
    {
        try
        {
            // Load all assets for dropdown
            var searchCommand = new SearchPhysicalAssetsCommand
            {
                PageNumber = 1,
                PageSize = 100
            };
            var result = await ApiClient.SearchPhysicalAssetsEndpointAsync("1", searchCommand, cancellationToken);
            if (result?.Items == null || result.Items.Count == 0)
                return Array.Empty<PhysicalAssetResponse>();

            // Filter results client-side based on search value (if provided)
            if (string.IsNullOrWhiteSpace(value))
            {
                // Return all items if no search filter
                return result.Items.ToList();
            }

            var filteredItems = result.Items
                .Where(a => a.PropertyCode.Contains(value, StringComparison.OrdinalIgnoreCase))
                .ToList();
            return filteredItems;
        }
        catch
        {
            return Array.Empty<PhysicalAssetResponse>();
        }
    }
}