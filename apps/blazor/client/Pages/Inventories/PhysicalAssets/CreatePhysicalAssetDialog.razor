@namespace AMIS.Blazor.Client.Pages.Inventories.PhysicalAssets
@using AMIS.Blazor.Client.Pages.Inventories.Products
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<EditForm Model="@Model">
    <MudDialog>
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="w-100">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" Color="Color.Primary" />
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">Create Physical Asset</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Add a new asset to your inventory</MudText>
                </div>
            </MudStack>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="1">
                <!-- Basic Information Section -->
                <MudCard Elevation="0" Class="pa-4" Style="background-color: rgba(63, 81, 181, 0.05);">
                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                        Basic Information
                    </MudText>
                    <MudGrid Spacing="1">
                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" Spacing="1" Style="align-items: flex-start;">
                                <MudTextField @bind-Value="Model.PropertyCode" Label="Property Code" 
                                    Required="true" Variant="Variant.Outlined"
                                    Clearable="true" Style="flex: 1;" />
                                <MudTooltip Text="Generate property code in Property Code Generator page">
                                    <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Info" Size="Size.Medium"
                                        OnClick="OpenPropertyCodeGenerator" />
                                </MudTooltip>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" Spacing="1" Style="align-items: flex-start;">
                                <MudAutocomplete T="ProductResponse" Label="Product" @bind-Value="_selectedProduct"
                                    SearchFunc="@SearchProducts" ToStringFunc="@(p => p == null ? string.Empty : p.Name)"
                                    Required="true" Clearable="true" ResetValueOnEmptyText="true" Variant="Variant.Outlined"
                                    Dense="false" Style="flex: 1;" />
                                <MudTooltip Text="Create a new product">
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Medium"
                                        OnClick="OpenNewProductDialog" />
                                </MudTooltip>
                            </MudStack>
                        </MudItem>

                    </MudGrid>
                </MudCard>

                <!-- Financial Information Section -->
                <div Style="display: flex; gap: 2rem; width: 100%;">
                    <div Style="width: 50%; display: flex; flex-direction: column; gap: 2rem;">
                        <MudCard Elevation="0" Class="pa-4" Style="background-color: rgba(76, 175, 80, 0.05);">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Small" Class="mr-1" />
                                Financial Information / Asset Hierarchy
                            </MudText>
                            <MudGrid Spacing="1">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_acquisitionCostStr" Label="Acquisition Cost" 
                                        Required="true" Variant="Variant.Outlined" Clearable="true" Style="width: 100%;" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudDatePicker @bind-Date="_acquisitionDate" Label="Acquisition Date" 
                                        Required="true" Variant="Variant.Outlined" Style="width: 100%;" 
                                        MaxDate="DateTime.UtcNow.Date" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudAutocomplete T="PhysicalAssetResponse" Label="Parent Asset" @bind-Value="_selectedParentAsset"
                                        SearchFunc="@SearchParentAssets" ToStringFunc="@(p => p == null ? string.Empty : $"{p.PropertyCode} - {p.Description}")"
                                        Clearable="true" ResetValueOnEmptyText="true" Variant="Variant.Outlined"
                                        Dense="false" Style="width: 100%;" />
                                </MudItem>
                            </MudGrid>
                        </MudCard>                      
                    </div>

                    <!-- Quantity & Specifications Section -->
                    <div Style="width: 50%;">
                        <MudCard Elevation="0" Class="pa-4" Style="background-color: rgba(255, 152, 0, 0.05);">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="mr-1" />
                                Quantity & Specifications
                            </MudText>
                            <div Style="display: flex; gap: 1rem; margin-bottom: 1rem;">
                                <div Style="flex: 1;">
                                    <MudNumericField @bind-Value="Model.Quantity" Label="Quantity" 
                                        Required="true" Variant="Variant.Outlined" Style="width: 100%;" />
                                </div>
                            </div>
                            <MudGrid Spacing="2">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="Model.SerialNumber" Label="Serial Number" 
                                        Variant="Variant.Outlined" Clearable="true" Style="width: 100%;" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="Model.ModelNumber" Label="Model Number" 
                                        Variant="Variant.Outlined" Clearable="true" Style="width: 100%;" />
                                </MudItem>
                            </MudGrid>
                        </MudCard>
                    </div>
                </div>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel" Disabled="@_loading" Class="px-6 py-2">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnCreate" Disabled="@_loading" Class="px-6 py-2">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Create Asset
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject]
    private IApiClient ApiClient { get; set; } = default!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    private CreatePhysicalAssetCommand Model = new()
    {
        PropertyCode = "",
        ProductId = Guid.Empty,
        AcquisitionCost = 0.0,
        AcquisitionDate = DateTime.UtcNow,
        Quantity = 1
    };
    private string _acquisitionCostStr = "";
    private DateTime? _acquisitionDate;
    private ProductResponse? _selectedProduct;
    private PhysicalAssetResponse? _selectedParentAsset;
    private bool _loading;

    protected override void OnInitialized()
    {
        _selectedProduct = null;
        _acquisitionCostStr = "";
        _acquisitionDate = DateTime.UtcNow;
    }

    private async Task OnCreate()
    {
        _loading = true;
        try
        {
            if (string.IsNullOrWhiteSpace(Model.PropertyCode))
            {
                Snackbar?.Add("Property code is required.", Severity.Warning);
                _loading = false;
                return;
            }

            if (_selectedProduct == null || _selectedProduct.Id == Guid.Empty)
            {
                Snackbar?.Add("Please select a product.", Severity.Warning);
                _loading = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(_acquisitionCostStr) || !double.TryParse(_acquisitionCostStr, out var cost) || cost <= 0)
            {
                Snackbar?.Add("Please provide a valid acquisition cost (must be greater than 0).", Severity.Warning);
                _loading = false;
                return;
            }

            if (!_acquisitionDate.HasValue)
            {
                Snackbar?.Add("Please select an acquisition date.", Severity.Warning);
                _loading = false;
                return;
            }

            Model.ProductId = _selectedProduct!.Id ?? Guid.Empty;
            Model.AcquisitionCost = cost;
            Model.AcquisitionDate = _acquisitionDate.Value;
            Model.ParentAssetId = _selectedParentAsset?.Id;

            var response = await ApiClient.CreatePhysicalAssetEndpointAsync("1", Model);
            if (response != null)
            {
                Snackbar?.Add("Physical asset created successfully.", Severity.Success);
                MudDialog?.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex)
        {
            Snackbar?.Add($"Error creating asset: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<IEnumerable<ProductResponse>> SearchProducts(string value, CancellationToken cancellationToken =
    default)
    {
        try
        {
            var searchCommand = new SearchProductsCommand
            {
                Keyword = value,
                PageNumber = 1,
                PageSize = 50
            };
            var result = await ApiClient.SearchProductsEndpointAsync("1", searchCommand, cancellationToken);
            
            if (result?.Items == null || result.Items.Count == 0)
            {
                return Array.Empty<ProductResponse>();
            }

            // If no search value, return all loaded products
            if (string.IsNullOrWhiteSpace(value))
            {
                return result.Items.ToList();
            }

            // Otherwise filter client-side
            var filteredItems = result.Items
                .Where(p => p.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
                .ToList();
            return filteredItems;
        }
        catch
        {
            return Array.Empty<ProductResponse>();
        }
    }

    private async Task<IEnumerable<PhysicalAssetResponse>> SearchParentAssets(string value, CancellationToken cancellationToken = default)
    {
        try
        {
            // Load all assets for dropdown
            var searchCommand = new SearchPhysicalAssetsCommand
            {
                PageNumber = 1,
                PageSize = 100
            };
            var result = await ApiClient.SearchPhysicalAssetsEndpointAsync("1", searchCommand, cancellationToken);
            if (result?.Items == null || result.Items.Count == 0)
                return Array.Empty<PhysicalAssetResponse>();

            // Filter results client-side based on search value (if provided)
            if (string.IsNullOrWhiteSpace(value))
            {
                // Return all items if no search filter
                return result.Items.ToList();
            }

            var filteredItems = result.Items
                .Where(a => a.PropertyCode.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                            a.Description.Contains(value, StringComparison.OrdinalIgnoreCase))
                .ToList();
            return filteredItems;
        }
        catch
        {
            return Array.Empty<PhysicalAssetResponse>();
        }
    }

    private async Task OpenNewProductDialog()
    {
        try
        {
            var parameters = new DialogParameters<ProductDialog>
            {
                { x => x.Model, new ProductViewModel() },
                { x => x.IsCreate, true },
                { x => x._categories, new List<CategoryResponse>() }
            };

            var dialog = await DialogService.ShowAsync<ProductDialog>("Create New Product", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

            var result = await dialog.Result;
            if (!result.Canceled)
            {
                Snackbar?.Add("Product created successfully. You can now select it from the list.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar?.Add($"Error opening product dialog: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel() => MudDialog?.Cancel();

    private async Task OpenPropertyCodeGenerator()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<PropertyCodeGenerator>("Generate Property Code", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string propertyCode)
        {
            Model.PropertyCode = propertyCode;
            Snackbar?.Add($"Property code set: {propertyCode}", Severity.Success);
        }
    }
}