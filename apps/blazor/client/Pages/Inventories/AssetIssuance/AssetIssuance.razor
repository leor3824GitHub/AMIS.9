@page "/inventories/asset-issuance"
@using AMIS.Blazor.Client.Components
@using AMIS.Blazor.Client.Components.General
@using AMIS.Blazor.Client.Pages.Inventories.AssetIssuance.Components
@using AMIS.Blazor.Infrastructure.Api
@using MudBlazor

<PageHeader 
    Title="Asset Issuance" 
    Header="Supply Officer Asset Issuance"
    SubHeader="Issue PPE (via PAR) and Semi-Expendable Property (via ICS) to custodians" />

<MudPaper Class="pa-4">
    <MudStack Row="true" Spacing="2" Class="mb-4">
        <MudTextField 
            @bind-Value="_searchString"
            Placeholder="Search by custodian name or asset..."
            Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Filled.Search"
            Immediate="true"
            Disabled="@(!_canSearch)"
            DebounceInterval="250"
            Variant="Variant.Outlined"
            OnKeyUp="@(async _ => await OnSearchAsync(_searchString))" />
        <MudSpacer />
        <MudButton 
            Disabled="@(!_canCreate)"
            Color="Color.Primary"
            Variant="Variant.Filled"
            StartIcon="@Icons.Material.Filled.Add"
            Class="equal-action-width"
            OnClick="OnCreateNewIssuance">
            New Issuance
        </MudButton>
    </MudStack>

    <MudTabs Elevation="1" Rounded="true">
        <!-- Pending Issuances Tab -->
        <MudTabPanel Text="Pending Issuances" Icon="@Icons.Material.Filled.Pending">
            <MudPaper Class="pa-4 mt-4" Elevation="0">
                <MudDataGrid 
                    T="IssuanceResponse"
                    @ref="_pendingTable"
                    ServerData="ServerReloadPending"
                    Loading="_loading"
                    Dense="true"
                    Hover="true"
                    Bordered="true"
                    Striped="true"
                    RowStyleFunc="@RowStylePending">
                    <Columns>
                        <PropertyColumn Property="x => x.IssuanceDate" Title="Date Issued" Format="{0:MMM dd, yyyy}" Sortable="false">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@context.Item.IssuanceDate.ToString("MMM dd, yyyy")</MudText>
                            </CellTemplate>
                        </PropertyColumn>
                        <TemplateColumn Title="Custodian" Sortable="false">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small">
                                        @GetInitials(context.Item.Employee?.Name)
                                    </MudAvatar>
                                    <MudStack Row="false" Spacing="0">
                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                            @(context.Item.Employee?.Name ?? "Unknown")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @(context.Item.Employee?.Designation ?? "")
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Document Type" Sortable="false">
                            <CellTemplate>
                                <MudChip 
                                    Size="Size.Small"
                                    Color="Color.Default"
                                    Variant="Variant.Filled">
                                    @GetDocumentTypeLabel(null)
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.TotalAmount" Title="Total Value" Format="{0:C2}" Sortable="false" />
                        <TemplateColumn Title="Status" Sortable="false">
                            <CellTemplate>
                                <MudChip 
                                    Size="Size.Small"
                                    Color="@GetStatusColor(context.Item.IsClosed ? "Closed" : "Open")"
                                    Variant="Variant.Outlined">
                                    @(context.Item.IsClosed ? "Closed" : "Open")
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton 
                                        Icon="@Icons.Material.Filled.Preview"
                                        Size="Size.Small"
                                        Color="Color.Info"
                                        OnClick="@(() => OnPreviewDocument(context.Item))"
                                        Title="Preview PAR/ICS" />
                                    <MudIconButton 
                                        Icon="@Icons.Material.Filled.Edit"
                                        Size="Size.Small"
                                        Color="Color.Primary"
                                        Disabled="@(context.Item.IsClosed)"
                                        OnClick="@(() => OnEditIssuance(context.Item))"
                                        Title="Edit Items" />
                                    <MudIconButton 
                                        Icon="@Icons.Material.Filled.Print"
                                        Size="Size.Small"
                                        Color="Color.Success"
                                        OnClick="@(() => OnPrint(context.Item))"
                                        Title="Print Document" />
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="IssuanceResponse" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudTabPanel>

        <!-- Completed Issuances Tab -->
        <MudTabPanel Text="Completed Issuances" Icon="@Icons.Material.Filled.CheckCircle">
            <MudPaper Class="pa-4 mt-4" Elevation="0">
                <MudDataGrid 
                    T="IssuanceResponse"
                    @ref="_completedTable"
                    ServerData="ServerReloadCompleted"
                    Loading="_loading"
                    Dense="true"
                    Hover="true"
                    Bordered="true"
                    Striped="true">
                    <Columns>
                        <PropertyColumn Property="x => x.IssuanceDate" Title="Date Issued" Format="{0:MMM dd, yyyy}" Sortable="false" />
                        <TemplateColumn Title="Custodian" Sortable="false">
                            <CellTemplate>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small">
                                        @GetInitials(context.Item.Employee?.Name)
                                    </MudAvatar>
                                    <MudStack Row="false" Spacing="0">
                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                            @(context.Item.Employee?.Name ?? "Unknown")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @(context.Item.Employee?.Designation ?? "")
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Document Type" Sortable="false">
                            <CellTemplate>
                                <MudChip Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">
                                    @GetDocumentTypeLabel(null)
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.TotalAmount" Title="Total Value" Format="{0:C2}" Sortable="false" />
                        <TemplateColumn Title="Status" Sortable="false">
                            <CellTemplate>
                                <MudChip Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                    Closed
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                <MudIconButton 
                                    Icon="@Icons.Material.Filled.Preview"
                                    Size="Size.Small"
                                    Color="Color.Info"
                                    OnClick="@(() => OnPreviewDocument(context.Item))"
                                    Title="Preview Document" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="IssuanceResponse" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudTabPanel>

        <!-- All Issuances Tab -->
        <MudTabPanel Text="All Issuances" Icon="@Icons.Material.Filled.List">
            <MudPaper Class="pa-4 mt-4" Elevation="0">
                <MudDataGrid 
                    T="IssuanceResponse"
                    @ref="_allTable"
                    ServerData="ServerReloadAll"
                    Loading="_loading"
                    Dense="true"
                    Hover="true"
                    Bordered="true"
                    Striped="true">
                    <Columns>
                        <PropertyColumn Property="x => x.IssuanceDate" Title="Date" Format="{0:MMM dd, yyyy}" Sortable="false" />
                        <TemplateColumn Title="Custodian" Sortable="false">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                    @(context.Item.Employee?.Name ?? "Unknown")
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Document Type" Sortable="false">
                            <CellTemplate>
                                <MudChip Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">
                                    @GetDocumentTypeLabel(null)
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.TotalAmount" Title="Value" Format="{0:C2}" Sortable="false" />
                        <TemplateColumn Title="Status" Sortable="false">
                            <CellTemplate>
                                <MudChip 
                                    Size="Size.Small"
                                    Color="@GetStatusColor(context.Item.IsClosed ? "Closed" : "Open")"
                                    Variant="Variant.Outlined">
                                    @(context.Item.IsClosed ? "Closed" : "Open")
                                </MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate>
                                <MudIconButton 
                                    Icon="@Icons.Material.Filled.Preview"
                                    Size="Size.Small"
                                    Color="Color.Info"
                                    OnClick="@(() => OnPreviewDocument(context.Item))" />
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="IssuanceResponse" />
                    </PagerContent>
                </MudDataGrid>
            </MudPaper>
        </MudTabPanel>
    </MudTabs>
</MudPaper>

<!-- Create/Edit Issuance Dialog -->
<AssetIssuanceDialog 
    @ref="_issuanceDialog"
    OnCreateSuccess="@OnIssuanceCreated"
    OnEditSuccess="@OnIssuanceUpdated" />

<!-- Document Preview Dialog -->
<DocumentPreviewDialog 
    @ref="_previewDialog"
    IssuanceData="@_selectedIssuanceForPreview" />


