@page "/inventories/issuances/workflow"
@using AMIS.Blazor.Infrastructure.Api
@using Microsoft.AspNetCore.Components.Authorization

<PageHeader Title="Asset Issuance Workflow"
    Description="Create issuances and generate ICS/PAR/RSMI forms for asset distribution" />

<AuthorizeView Roles="Supply Officer">
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-8">
            <MudAlert Severity="Severity.Info">
                <MudText>This page allows you to create asset issuances and generate the appropriate documents (ICS,
                    PAR, RSMI).</MudText>
                <MudText Class="mt-2"><strong>Coming Soon:</strong> Full workflow implementation with requisition
                    selection and document generation.</MudText>
            </MudAlert>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Warning">
            You do not have permission to access this page. Only Supply Officers can create issuances.
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>
