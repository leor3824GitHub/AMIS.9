@using AMIS.Blazor.Infrastructure.Api
@using MudBlazor
@using System.ComponentModel.DataAnnotations
@using System.Collections.ObjectModel

<MudDialog @bind-IsVisible="_isDialogOpen">
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                PPE Issuance Report (PPEIR) - Fill out details and line items
            </MudAlert>
            <MudForm @ref="_form" Model="_model">
                <MudStack Row="true" Spacing="2" Class="mb-3" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" StartIcon="@Icons.Material.Filled.Save">Save PPEIR</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Reset" StartIcon="@Icons.Material.Filled.Restore">Reset</MudButton>
                </MudStack>

                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
                    <MudTabPanel Text="Report Details" Icon="@Icons.Material.Filled.Description">
                        <MudGrid GutterSize="2" Class="mt-2">
                            <MudItem xs="12" md="2">
                                <MudTextField @bind-Value="_model.ReportNumber" For="@(() => _model.ReportNumber)" Label="Report Number" Required="true" Class="w-50" />
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudTextField @bind-Value="_model.RecipientName" For="@(() => _model.RecipientName)" Label="Recipient Name" Required="true" FullWidth="true" />
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudTextField @bind-Value="_model.RecipientAddress" For="@(() => _model.RecipientAddress)" Label="Recipient Address" Required="true" FullWidth="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudSelect @bind-Value="_model.IssuanceType" For="@(() => _model.IssuanceType)" Label="Issuance Type" Required="true">
                                    <MudSelectItem Value="@("Sale")">Sale</MudSelectItem>
                                    <MudSelectItem Value="@("Transfer")">Transfer</MudSelectItem>
                                    <MudSelectItem Value="@("Donation")">Donation</MudSelectItem>
                                    <MudSelectItem Value="@("Disposal")">Disposal</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudDatePicker @bind-Date="_model.IssuanceDate" For="@(() => _model.IssuanceDate)" Label="Issuance Date" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_model.Notes" For="@(() => _model.Notes)" Label="Notes" Lines="3" FullWidth="true" />
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Line Items" Icon="@Icons.Material.Filled.ViewList">
                        <MudStack Spacing="2" Class="mt-3">
                            <MudText Typo="Typo.subtitle2">Add Line Items</MudText>
                            <MudGrid GutterSize="2">
                                <MudItem xs="12" md="3">
                                    <MudTextField @bind-Value="_draft.PropertyCode" Label="Property Code" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudTextField @bind-Value="_draft.Description" Label="Description" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField @bind-Value="_draft.Quantity" Label="Qty" Min="1" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudTextField @bind-Value="_draft.Unit" Label="Unit" />
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudDatePicker @bind-Date="_draft.DateAcquired" Label="Date Acquired" />
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudNumericField @bind-Value="_draft.AcquisitionCost" Label="Acquisition Cost" Min="0" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField @bind-Value="_draft.AccumulatedDepreciation" Label="Depreciation" Min="0" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField @bind-Value="_draft.BookValue" Label="Book Value" Min="0" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddItemAsync" StartIcon="@Icons.Material.Filled.Add" FullWidth="true">Add</MudButton>
                                </MudItem>
                            </MudGrid>

                            @if (_model.LineItems.Count > 0)
                            {
                                <MudTable Items="@_model.LineItems.ToList()" Dense="true" Hover="true" Class="mt-3">
                                    <HeaderContent>
                                        <MudTh>Code</MudTh>
                                        <MudTh>Description</MudTh>
                                        <MudTh>Qty</MudTh>
                                        <MudTh>Unit</MudTh>
                                        <MudTh>Date Acquired</MudTh>
                                        <MudTh align="right">Acquisition Cost</MudTh>
                                        <MudTh align="right">Depreciation</MudTh>
                                        <MudTh align="right">Book Value</MudTh>
                                        <MudTh align="center">Actions</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Code">@context.PropertyCode</MudTd>
                                        <MudTd DataLabel="Description">@context.Description</MudTd>
                                        <MudTd DataLabel="Qty">@context.Quantity</MudTd>
                                        <MudTd DataLabel="Unit">@context.Unit</MudTd>
                                        <MudTd DataLabel="Date Acquired">@context.DateAcquired?.ToString("MMM dd, yyyy")</MudTd>
                                        <MudTd DataLabel="Acquisition Cost" align="right">@context.AcquisitionCost.ToString("C")</MudTd>
                                        <MudTd DataLabel="Depreciation" align="right">@context.AccumulatedDepreciation?.ToString("C")</MudTd>
                                        <MudTd DataLabel="Book Value" align="right">@context.BookValue?.ToString("C")</MudTd>
                                        <MudTd align="center">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditItemAsync(_model.LineItems.ToList().IndexOf(context)))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Info" Size="Size.Small" OnClick="@(() => DuplicateItemAsync(context))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveItemAsync(_model.LineItems.ToList().IndexOf(context)))" />
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudStack>
                    </MudTabPanel>
                </MudTabs>
            </MudForm>
        </MudStack>
    </DialogContent>
</MudDialog>

@code {
    private const string ApiVersion = "1";
    [Inject] public IApiClient ApiClient { get; set; } = default!;
    [Inject] public ISnackbar Snackbar { get; set; } = default!;
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _isDialogOpen;
    private MudForm? _form;
    private PpeIssuanceModel _model = new();
    private PpeIssuanceLineItemModel _draft = new();
    private int _editingIndex = -1;

    public void Open()
    {
        Reset();
        _isDialogOpen = true;
    }

    private void Reset()
    {
        _model = new();
        _draft = new();
        _editingIndex = -1;
    }

    private async Task AddItemAsync()
    {
        if (_editingIndex >= 0)
        {
            _model.LineItems[_editingIndex] = new PpeIssuanceLineItemModel
            {
                PropertyCode = _draft.PropertyCode.Trim(),
                Description = _draft.Description.Trim(),
                Quantity = _draft.Quantity,
                Unit = _draft.Unit?.Trim() ?? "pcs",
                DateAcquired = _draft.DateAcquired,
                AcquisitionCost = _draft.AcquisitionCost,
                AccumulatedDepreciation = _draft.AccumulatedDepreciation,
                BookValue = _draft.BookValue,
            };
            Snackbar.Add("Item updated", Severity.Success);
            _editingIndex = -1;
        }
        else
        {
            _model.LineItems.Add(new PpeIssuanceLineItemModel
            {
                PropertyCode = _draft.PropertyCode.Trim(),
                Description = _draft.Description.Trim(),
                Quantity = _draft.Quantity,
                Unit = _draft.Unit?.Trim() ?? "pcs",
                DateAcquired = _draft.DateAcquired,
                AcquisitionCost = _draft.AcquisitionCost,
                AccumulatedDepreciation = _draft.AccumulatedDepreciation,
                BookValue = _draft.BookValue,
            });
        }
        _draft = new();
    }

    private async Task EditItemAsync(int index)
    {
        _draft = new PpeIssuanceLineItemModel
        {
            PropertyCode = _model.LineItems.ElementAt(index).PropertyCode,
            Description = _model.LineItems.ElementAt(index).Description,
            Quantity = _model.LineItems.ElementAt(index).Quantity,
            Unit = _model.LineItems.ElementAt(index).Unit,
            DateAcquired = _model.LineItems.ElementAt(index).DateAcquired,
            AcquisitionCost = _model.LineItems.ElementAt(index).AcquisitionCost,
            AccumulatedDepreciation = _model.LineItems.ElementAt(index).AccumulatedDepreciation,
            BookValue = _model.LineItems.ElementAt(index).BookValue,
        };
        _editingIndex = index;
    }

    private async Task RemoveItemAsync(int index)
    {
        _model.LineItems.Remove(_model.LineItems.ElementAt(index));
    }

    private async Task DuplicateItemAsync(PpeIssuanceLineItemModel item)
    {
        _draft = new PpeIssuanceLineItemModel
        {
            PropertyCode = item.PropertyCode,
            Description = item.Description,
            Quantity = item.Quantity,
            Unit = item.Unit,
            DateAcquired = item.DateAcquired,
            AcquisitionCost = item.AcquisitionCost,
            AccumulatedDepreciation = item.AccumulatedDepreciation,
            BookValue = item.BookValue,
        };
        Snackbar.Add("Item duplicated to draft. Click 'Add Item' to save.", Severity.Info);
    }

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid)
        {
            Snackbar.Add("Please fix validation errors", Severity.Warning);
            return;
        }

        if (_model.LineItems.Count == 0)
        {
            Snackbar.Add("Add at least one line item", Severity.Warning);
            return;
        }

        if (_model.IssuanceDate > DateTime.Today)
        {
            Snackbar.Add("Issuance date cannot be in the future", Severity.Warning);
            return;
        }

        try
        {
            var command = new CreatePpeIssuanceReportCommand
            {
                ReportNumber = _model.ReportNumber,
                RecipientName = _model.RecipientName,
                RecipientAddress = _model.RecipientAddress,
                IssuanceType = _model.IssuanceType,
                IssuanceDate = _model.IssuanceDate ?? DateTime.Today,
                Notes = _model.Notes,
                LineItems = _model.LineItems.Select(x => new CreatePpeIssuanceLineItemRequest
                {
                    PropertyCode = x.PropertyCode,
                    Description = x.Description,
                    Quantity = x.Quantity,
                    Unit = x.Unit,
                    DateAcquired = x.DateAcquired,
                    AcquisitionCost = x.AcquisitionCost,
                    AccumulatedDepreciation = x.AccumulatedDepreciation,
                    BookValue = x.BookValue,
                }).ToList(),
            };

            var response = await ApiClient.CreatePpeIssuanceReportEndpointAsync(ApiVersion, command);
            Snackbar.Add("PPE Issuance Report saved", Severity.Success);
            await OnSaved.InvokeAsync();
            _isDialogOpen = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    public class PpeIssuanceModel
    {
        public Guid Id { get; set; }

        [Required, MaxLength(50)]
        public string ReportNumber { get; set; } = string.Empty;

        [Required]
        public string RecipientName { get; set; } = string.Empty;

        [Required]
        public string RecipientAddress { get; set; } = string.Empty;

        [Required, MaxLength(50)]
        public string IssuanceType { get; set; } = "Sale";

        [Required]
        public DateTime? IssuanceDate { get; set; } = DateTime.Today;

        public string Notes { get; set; } = string.Empty;

        public Collection<PpeIssuanceLineItemModel> LineItems { get; } = new();
    }

    public class PpeIssuanceLineItemModel
    {
        [MaxLength(50)]
        public string PropertyCode { get; set; } = string.Empty;

        [MaxLength(500)]
        public string Description { get; set; } = string.Empty;

        public double Quantity { get; set; } = 1;

        [MaxLength(50)]
        public string Unit { get; set; } = "pcs";

        public DateTime? DateAcquired { get; set; }

        public double AcquisitionCost { get; set; }

        public double? AccumulatedDepreciation { get; set; } = 0;

        public double? BookValue { get; set; } = 0;
    }
}
