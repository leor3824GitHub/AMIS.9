@page "/inventories/reports/smir"
@using AMIS.Blazor.Client.Components
@using AMIS.Blazor.Infrastructure.Api
<PageHeader Title="SMIR" Header="Supplies and Materials Issuance Report" SubHeader="Capture issuance of supplies and materials from the warehouse" />

<MudPaper Class="report-shell pa-4">
    <MudStack Spacing="3">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Supplies and Materials Issuance Report (SMIR) for consumables leaving the warehouse.
        </MudAlert>
        <MudForm @ref="_form" Model="_model">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
                <MudTabPanel Text="Report Details" Icon="@Icons.Material.Filled.Description">
                    <MudGrid GutterSize="2">
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_model.SmirNumber" For="@(() => _model.SmirNumber)" Label="SMIR Number" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_model.TransactionDate" Label="Transaction Date" Required="true" MaxDate="@DateTime.Today" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="string" @bind-Value="_model.IssuanceReason" Label="Issuance Reason" Required="true">
                                @foreach (var reason in Reasons)
                                {
                                    <MudSelectItem Value="@reason">@reason</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_model.RecipientName" For="@(() => _model.RecipientName)" Label="Recipient Name" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_model.RecipientAddress" For="@(() => _model.RecipientAddress)" Label="Recipient Address" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_model.RecipientContactNumber" Label="Recipient Contact No." />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_model.IssuingOfficerName" For="@(() => _model.IssuingOfficerName)" Label="Issuing Officer" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_model.IssuingDate" Label="Issuing Date" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_model.ApprovingOfficerName" Label="Approving Officer" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_model.ApprovingDate" Label="Approving Date" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_model.AuthRecipientName" For="@(() => _model.AuthRecipientName)" Label="Authorized Recipient" Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_model.AuthReceiptDate" Label="Authorized Receipt Date" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_model.DriverName" Label="Driver Name" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_model.BillOfLadingNumber" Label="Bill of Lading No." />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_model.Notes" Label="Notes" Lines="3" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Line Items" Icon="@Icons.Material.Filled.List" BadgeData="@_model.LineItems.Count" BadgeColor="Color.Info">
                    <MudPaper Class="line-card pa-3">
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle1">Line Items</MudText>
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@_model.LineItems.Count item(s)</MudChip>
                        </MudStack>
                        <MudGrid GutterSize="2" Class="mt-2">
                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="_draft.Name" For="@(() => _draft.Name)" Label="Item Name" Required="true" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="_draft.Description" Label="Description" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudDatePicker @bind-Date="_draft.AcquisitionDate" Label="Acquisition Date" />
                            </MudItem>
                            <MudItem xs="6" md="1">
                                <MudNumericField T="double" @bind-Value="_draft.Quantity" Label="Qty" Min="0" Required="true" HideSpinButtons="true" />
                            </MudItem>
                            <MudItem xs="6" md="1">
                                <MudTextField @bind-Value="_draft.Unit" Label="Unit" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField T="double" @bind-Value="_draft.UnitCost" Label="Unit Cost" Min="0" HideSpinButtons="true" Adornment="Adornment.Start" AdornmentText="₱" />
                            </MudItem>
                        </MudGrid>
                        <MudStack Row="true" Spacing="1" Class="mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddLineItem" StartIcon="@Icons.Material.Filled.Add" Disabled="_model.LineItems.Count >= 25">Add Item</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetDraft" StartIcon="@Icons.Material.Filled.Refresh">Clear Draft</MudButton>
                        </MudStack>

                        <MudTable Items="_model.LineItems" Dense="true" Hover="true" Class="mt-3">
                            <HeaderContent>
                                <MudTh>Name</MudTh>
                                <MudTh>Description</MudTh>
                                <MudTh>Qty</MudTh>
                                <MudTh>Unit</MudTh>
                                <MudTh align="right">Unit Cost</MudTh>
                                <MudTh align="right">Total</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Name">@context.Name</MudTd>
                                <MudTd DataLabel="Description">@context.Description</MudTd>
                                <MudTd DataLabel="Qty">@context.Quantity</MudTd>
                                <MudTd DataLabel="Unit">@context.Unit</MudTd>
                                <MudTd DataLabel="Unit Cost" align="right">@context.UnitCost.ToString("C2")</MudTd>
                                <MudTd DataLabel="Total" align="right">@(context.UnitCost * context.Quantity).ToString("C2")</MudTd>
                                <MudTd align="right">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => RemoveItem(context)" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudTabPanel>
            </MudTabs>

            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" StartIcon="@Icons.Material.Filled.Save">Save SMIR</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Reset" StartIcon="@Icons.Material.Filled.Restore">Reset</MudButton>
            </MudStack>
        </MudForm>

        @if (_createdId is not null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Filled">
                SMIR created with Id: @_createdId
            </MudAlert>
        }
    </MudStack>
</MudPaper>
