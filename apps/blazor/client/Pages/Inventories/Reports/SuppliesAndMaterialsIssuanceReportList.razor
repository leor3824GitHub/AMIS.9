@page "/inventories/reports/smir-list"
@using AMIS.Blazor.Infrastructure.Api
@inject IAuthorizationService AuthService
@inject NavigationManager NavigationManager

<PageHeader Title="SMIR List" Header="Supplies & Materials Issuance Reports" SubHeader="View and manage Supplies & Materials Issuance Reports" />

<MudPaper Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateNewReport"
                StartIcon="@Icons.Material.Filled.Add" Disabled="!_canCreate">New Report</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="LoadReports"
                StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>
        </MudStack>

        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_reports == null || _reports.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                No Supplies & Materials Issuance Reports found. <MudLink OnClick="CreateNewReport" style="cursor: pointer;">
                    Create one now</MudLink>
            </MudAlert>
        }
        else
        {
            <MudTable Items="@_reports" Dense="true" Hover="true" Striped="true" Bordered="true">
                <HeaderContent>
                    <MudTh>SMIR Number</MudTh>
                    <MudTh>Issued To</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Issuance Date</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh align="center">Items</MudTh>
                    <MudTh align="right">Total Amount</MudTh>
                    <MudTh>Created Date</MudTh>
                    <MudTh align="center">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="SMIR Number">@context.SmirNumber</MudTd>
                    <MudTd DataLabel="Issued To">@context.IssuedToName</MudTd>
                    <MudTd DataLabel="Type">@context.TransactionType</MudTd>
                    <MudTd DataLabel="Issuance Date">@context.IssuanceDate.ToString("MMM dd, yyyy")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled"
                            Size="Size.Small">
                            @GetStatusText(context.Status)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Items" align="center">
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                            @context.LineItemsCount
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Total Amount" align="right">@context.TotalAmount.ToString("N2")</MudTd>
                    <MudTd DataLabel="Created Date">@context.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</MudTd>
                    <MudTd align="center">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info"
                            OnClick="@(() => ViewDetails(context.Id))" Title="View Details" />
                        <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Info"
                            OnClick="@(() => PrintReport(context.Id))" Title="Print" />
                        @if (context.Status == 0)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Lock" Color="Color.Warning"
                                OnClick="@(() => PostReport(context.Id))" Title="Post" Disabled="!_canUpdate" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Undo" Color="Color.Error"
                                OnClick="@(() => CancelReport(context.Id))" Title="Cancel & Reverse" Disabled="!_canDelete" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
</MudPaper>

@code {
    private const string ApiVersion = "1";
    [Inject] public IApiClient ApiClient { get; set; } = default!;
    [Inject] public ISnackbar Snackbar { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<SuppliesAndMaterialsIssuanceReportDto> _reports = [];
    private bool _isLoading;
    private bool _canCreate;
    private bool _canUpdate;
    private bool _canDelete;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _canCreate = await AuthService.HasPermissionAsync(user, FshActions.Create, FshResources.SuppliesAndMaterialsIssuance);
        _canUpdate = await AuthService.HasPermissionAsync(user, FshActions.Update, FshResources.SuppliesAndMaterialsIssuance);
        _canDelete = await AuthService.HasPermissionAsync(user, FshActions.Delete, FshResources.SuppliesAndMaterialsIssuance);
        await LoadReports();
    }

    private async Task LoadReports()
    {
        _isLoading = true;
        try
        {
            var response = await ApiClient.ListSuppliesAndMaterialsIssuanceReportsEndpointAsync(ApiVersion);
            _reports = response.Reports?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading reports: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void CreateNewReport()
    {
        NavigationManager.NavigateTo("/inventories/reports/smir");
    }

    private void ViewDetails(Guid id)
    {
        NavigationManager.NavigateTo($"/inventories/reports/smir/{id}?readonly=true");
    }

    private void PrintReport(Guid id)
    {
        NavigationManager.NavigateTo($"/inventories/reports/smir/{id}?readonly=true&print=true");
    }

    private async Task PostReport(Guid id)
    {
        try
        {
            await ApiClient.PostSuppliesAndMaterialsIssuanceReportEndpointAsync(ApiVersion, id);
            Snackbar.Add("Supplies & Materials Issuance Report posted successfully", Severity.Success);
            await LoadReports();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error posting report: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelReport(Guid id)
    {
        try
        {
            await ApiClient.CancelSuppliesAndMaterialsIssuanceReportEndpointAsync(ApiVersion, id);
            Snackbar.Add("Supplies & Materials Issuance Report cancelled successfully", Severity.Success);
            await LoadReports();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error cancelling report: {ex.Message}", Severity.Error);
        }
    }

    private string GetStatusText(int status)
    {
        return status switch
        {
            0 => "Draft",
            1 => "Posted",
            2 => "Cancelled",
            _ => "Unknown"
        };
    }

    private Color GetStatusColor(int status)
    {
        return status switch
        {
            0 => Color.Warning,
            1 => Color.Success,
            2 => Color.Error,
            _ => Color.Default
        };
    }
}
