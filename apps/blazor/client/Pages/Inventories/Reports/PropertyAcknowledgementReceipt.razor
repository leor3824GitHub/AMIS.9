@page "/inventories/reports/par"
@page "/inventories/reports/par/{ReportId}"
@using AMIS.Blazor.Client.Components
@using AMIS.Blazor.Infrastructure.Api
@using System.ComponentModel.DataAnnotations

<PageHeader Title="Property Acknowledgement Receipt (PAR)" Header="Property Acknowledgement Receipt"
    SubHeader="Assign PPE to custodians" />

@code {
    [Parameter]
    public string? ReportId { get; set; }
}

<MudPaper Class="report-shell pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="flex-1">
                Property Acknowledgement Receipt (PAR) for PPE custodian assignment and accountability.
                @if (_isReadOnly)
                {
                    <strong> - View Only Mode</strong>
                }
            </MudAlert>
            <MudChip T="string" Variant="Variant.Outlined" Color="@(_reportStatus == 0 ? Color.Warning : Color.Success)"
                Icon="@(_reportStatus == 0 ? Icons.Material.Filled.Edit : Icons.Material.Filled.Lock)">
                @_reportStatusText
            </MudChip>
        </MudStack>

        <MudStack Row="true" Spacing="1">
            @if (!_isReadOnly)
            {
                @if (_reportStatus == 0)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SubmitAsync" Disabled="@(!CanSave)"
                        StartIcon="@Icons.Material.Filled.Save">@_actionButtonText</MudButton>
                    @if (CanPost)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="PostAsync"
                            StartIcon="@Icons.Material.Filled.Lock">Post &amp; Assign</MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetWithConfirmation"
                        StartIcon="@Icons.Material.Filled.Refresh">Reset</MudButton>
                    @if (_reportId.HasValue)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => CancelEdit())"
                            StartIcon="@Icons.Material.Filled.Close">Cancel Edit</MudButton>
                    }
                }
                else if (_reportStatus == 1) // Posted
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ReturnAsync"
                        StartIcon="@Icons.Material.Filled.Undo">Return Items</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="CancelPARAsync"
                        StartIcon="@Icons.Material.Filled.Cancel">Cancel PAR</MudButton>
                }
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="@(() => PrintAsync())"
                StartIcon="@Icons.Material.Filled.Print">Print</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => GoToList())"
                StartIcon="@Icons.Material.Filled.ArrowBack">Back to List</MudButton>
        </MudStack>

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            <MudTabPanel Text="PAR Details" Icon="@Icons.Material.Filled.Description">
                <MudGrid GutterSize="2">
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_model.PARNumber" For="@(() => _model.PARNumber)" Label="PAR Number"
                            Required="true" MaxLength="20" Disabled="@(_reportStatus != 0 || _isReadOnly)" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudDatePicker @bind-Value="_model.IssuanceDate" Label="Issuance Date" Required="true"
                            MaxDate="@DateTime.Today" Format="MM/dd/yyyy"
                            Disabled="@(_reportStatus != 0 || _isReadOnly)" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_model.Position" For="@(() => _model.Position)" Label="Position"
                            Disabled="@(_reportStatus != 0 || _isReadOnly)" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="EmployeeResponse" @bind-Value="_selectedEmployee" Label="Employee/Custodian"
                            Required="true" SearchFunc="@SearchEmployees" ToStringFunc="@(e => e?.Name ?? "")"
                            Disabled="@(_reportStatus != 0 || _isReadOnly)" Clearable="true">
                            <ItemTemplate Context="employee">
                                <MudText>@employee.Name</MudText>
                                <MudText Typo="Typo.caption">@employee.ResponsibilityCode</MudText>
                            </ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.Department" For="@(() => _model.Department)"
                            Label="Department" Required="true" Disabled="@(_reportStatus != 0 || _isReadOnly)" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.IssuancePurpose" For="@(() => _model.IssuancePurpose)"
                            Label="Issuance Purpose" Lines="2" Disabled="@(_reportStatus != 0 || _isReadOnly)" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_model.IssuanceLocation" For="@(() => _model.IssuanceLocation)"
                            Label="Issuance Location" Disabled="@(_reportStatus != 0 || _isReadOnly)" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Notes" For="@(() => _model.Notes)" Label="Notes" Lines="3"
                            Disabled="@(_reportStatus != 0 || _isReadOnly)" />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="PPE Line Items" Icon="@Icons.Material.Filled.List" BadgeData="@_model.LineItems.Count"
                BadgeColor="Color.Info">
                <MudPaper Class="line-card pa-3">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle1">PPE Line Items</MudText>
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@_model.LineItems.Count
                            item(s)</MudChip>
                    </MudStack>

                    @if (_reportStatus == 0 && !_isReadOnly)
                    {
                        <MudGrid GutterSize="2" Class="mt-2">
                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="_currentLineItem.PropertyCode" Label="Property Code" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="_currentLineItem.Description" Label="Description" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudDatePicker @bind-Value="_currentLineItem.DateAcquired" Label="Date Acquired"
                                    MaxDate="@DateTime.Today" Format="MM/dd/yyyy" />
                            </MudItem>
                            <MudItem xs="12" md="2">
                                <MudNumericField @bind-Value="_currentLineItem.AcquisitionCost" Label="Cost" Min="0"
                                    Format="N2" HideSpinButtons="true" Adornment="Adornment.Start" AdornmentText="₱" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="_currentLineItem.Condition" Label="Condition" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField @bind-Value="_currentLineItem.Remarks" Label="Remarks" />
                            </MudItem>
                        </MudGrid>
                        <MudStack Row="true" Spacing="1" Class="mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveLineItem"
                                StartIcon="@(_editingLineItem != null ? Icons.Material.Filled.Save : Icons.Material.Filled.Add)">
                                @(_editingLineItem != null ? "Save Item" : "Add Item")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelLineItemEdit"
                                StartIcon="@Icons.Material.Filled.Refresh">Clear Draft</MudButton>
                        </MudStack>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                            This PAR is locked (Posted). Cannot add or edit line items.
                        </MudAlert>
                    }

                    <MudTable Items="_model.LineItems" Dense="true" Hover="true" Class="mt-3">
                        <HeaderContent>
                            <MudTh>Property Code</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Date Acquired</MudTh>
                            <MudTh align="right">Acquisition Cost</MudTh>
                            <MudTh>Condition</MudTh>
                            <MudTh>Remarks</MudTh>
                            @if (_reportStatus == 0 && !_isReadOnly)
                            {
                                <MudTh></MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Property Code">@context.PropertyCode</MudTd>
                            <MudTd DataLabel="Description">@context.Description</MudTd>
                            <MudTd DataLabel="Date Acquired">@(context.DateAcquired != default(DateTime) ?
                                                                context.DateAcquired.ToString("MM/dd/yyyy") : "N/A")</MudTd>
                            <MudTd DataLabel="Acquisition Cost" align="right">@context.AcquisitionCost.ToString("N2")
                            </MudTd>
                            <MudTd DataLabel="Condition">@context.Condition</MudTd>
                            <MudTd DataLabel="Remarks">@context.Remarks</MudTd>
                            <MudTd align="right">
                                @if (_reportStatus == 0 && !_isReadOnly)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info"
                                        OnClick="() => EditLineItem(context)" Title="Edit" Size="Size.Small" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                        OnClick="() => RemoveLineItem(context)" Title="Remove" Size="Size.Small" />
                                }
                                else
                                {
                                    <MudChip T="string" Disabled="true" Color="Color.Default"
                                        Icon="@Icons.Material.Filled.Lock" Size="Size.Small">
                                        @(_isReadOnly ? "Read-Only" : "Locked")
                                    </MudChip>
                                }
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd colspan="3" Style="text-align:right; font-weight:bold;">Total Value:</MudTd>
                            <MudTd align="right" Style="font-weight:bold; font-size:1.1em;">
                                @(_model.LineItems.Sum(x => x.AcquisitionCost).ToString("N2"))
                            </MudTd>
                            <MudTd colspan="2"></MudTd>
                            @if (_reportStatus == 0 && !_isReadOnly)
                            {
                                <MudTd></MudTd>
                            }
                        </FooterContent>
                    </MudTable>
                </MudPaper>
            </MudTabPanel>

            @if (_reportStatus > 0)
            {
                <MudTabPanel Text="Signatures" Icon="@Icons.Material.Filled.Draw">
                    <MudGrid GutterSize="2">
                        <MudItem xs="12" md="4">
                            <MudTextField Value="@_model.IssuedByName" Label="Issued By" ReadOnly="true" />
                            <MudTextField Value="@_model.IssuedByDate?.ToString("MM/dd/yyyy")" Label="Date Issued"
                                ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Value="@_model.ReceivedByName" Label="Received By" ReadOnly="true" />
                            <MudTextField Value="@_model.ReceivedByDate?.ToString("MM/dd/yyyy")" Label="Date Received"
                                ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Value="@_model.ApprovedByName" Label="Approved By" ReadOnly="true" />
                            <MudTextField Value="@_model.ApprovedByDate?.ToString("MM/dd/yyyy")" Label="Date Approved"
                                ReadOnly="true" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            }
        </MudTabs>
    </MudStack>
</MudPaper>