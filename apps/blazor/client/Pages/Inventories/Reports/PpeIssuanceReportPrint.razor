@using AMIS.Blazor.Client.Pages.Inventories.Reports

<div style="width: 8.5in; margin: 0 auto; padding: 0.5in; font-family: Arial, sans-serif; line-height: 1.2; font-size: 12px;">
    <!-- Header -->
    <div style="text-align: center; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 12px;">
        <div style="font-weight: bold; font-size: 11px;">Republic of the Philippines</div>
        <div style="font-weight: bold; font-size: 12px; margin: 2px 0;">NATIONAL FOOD AUTHORITY</div>
        <div style="font-weight: bold; font-size: 13px; margin-top: 6px;">PPE ISSUANCE REPORT</div>
    </div>

    <!-- Report Number and Date Row -->
    <div style="display: flex; justify-content: space-between; margin-bottom: 12px;">
        <div style="flex: 1;">
            <strong>IR</strong> No @Model.ReportNumber
        </div>
        <div style="text-align: right;">
            <strong>Date:</strong> @(Model.IssuanceDate?.ToString("MM/dd/yyyy") ?? "")
        </div>
    </div>

    <!-- Issued To and Options -->
    <div style="margin-bottom: 12px;">
        <table style="width: 100%; border-collapse: collapse;">
            <tr>
                <td style="border: 1px solid #000; padding: 4px; width: 40%;">
                    <strong>Issued To:</strong><br>
                    @Model.RecipientName
                </td>
                <td style="border: 1px solid #000; padding: 4px;">
                    <div style="display: flex; gap: 12px; font-size: 11px;">
                        <label>☐ Sale</label>
                        <label>☐ Transfer to C.O</label>
                        <label>☐ Transfer to R.O</label>
                        <label>☐ Transfer to P.O</label>
                    </div>
                    <div style="display: flex; gap: 12px; font-size: 11px; margin-top: 3px;">
                        <label>☐ Donation</label>
                        <label>☐ Dumping</label>
                        <label>☐ Destruction</label>
                        <label>☐ Others</label>
                    </div>
                </td>
            </tr>
            <tr>
                <td style="border: 1px solid #000; padding: 4px;">
                    <strong>Address:</strong><br>
                    @Model.RecipientAddress
                </td>
                <td style="border: 1px solid #000; padding: 4px;">
                </td>
            </tr>
        </table>
    </div>

    <!-- Line Items Table -->
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
        <thead>
            <tr style="background-color: #f0f0f0;">
                <th style="border: 1px solid #000; padding: 4px; text-align: left; font-weight: bold; font-size: 11px;">Property Code</th>
                <th style="border: 1px solid #000; padding: 4px; text-align: left; font-weight: bold; font-size: 11px;">Serial Number</th>
                <th style="border: 1px solid #000; padding: 4px; text-align: left; font-weight: bold; font-size: 11px;">PPE Specifications</th>
                <th style="border: 1px solid #000; padding: 4px; text-align: center; font-weight: bold; font-size: 11px;">Date Acquired</th>
                <th style="border: 1px solid #000; padding: 4px; text-align: right; font-weight: bold; font-size: 11px;">Acquisition Cost</th>
                <th style="border: 1px solid #000; padding: 4px; text-align: right; font-weight: bold; font-size: 11px;">Accum. Depreciation</th>
                <th style="border: 1px solid #000; padding: 4px; text-align: right; font-weight: bold; font-size: 11px;">Book Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.LineItems)
            {
                <tr>
                    <td style="border: 1px solid #000; padding: 4px;">@item.PropertyCode</td>
                    <td style="border: 1px solid #000; padding: 4px;"></td>
                    <td style="border: 1px solid #000; padding: 4px;">@item.Description</td>
                    <td style="border: 1px solid #000; padding: 4px; text-align: center;">@(item.DateAcquired?.ToString("MM/dd/yyyy") ?? "")</td>
                    <td style="border: 1px solid #000; padding: 4px; text-align: right;">@item.AcquisitionCost.ToString("C2")</td>
                    <td style="border: 1px solid #000; padding: 4px; text-align: right;">@((item.AccumulatedDepreciation ?? 0).ToString("C2"))</td>
                    <td style="border: 1px solid #000; padding: 4px; text-align: right;">@((item.BookValue ?? 0).ToString("C2"))</td>
                </tr>
            }
            <!-- Empty rows for printing -->
            @for (int i = Model.LineItems.Count; i < 10; i++)
            {
                <tr style="height: 24px;">
                    <td style="border: 1px solid #000; padding: 4px;"></td>
                    <td style="border: 1px solid #000; padding: 4px;"></td>
                    <td style="border: 1px solid #000; padding: 4px;"></td>
                    <td style="border: 1px solid #000; padding: 4px;"></td>
                    <td style="border: 1px solid #000; padding: 4px;"></td>
                    <td style="border: 1px solid #000; padding: 4px;"></td>
                    <td style="border: 1px solid #000; padding: 4px;"></td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Footer Section -->
    <div style="margin-top: 20px;">
        <table style="width: 100%; border-collapse: collapse;">
            <tr>
                <td style="border: 1px solid #000; padding: 4px; width: 25%; vertical-align: top; height: 50px;">
                    <strong style="font-size: 11px;">Issued by:</strong><br>
                    <span style="font-size: 9px;">Name & Signature</span>
                </td>
                <td style="border: 1px solid #000; padding: 4px; width: 25%; vertical-align: top; height: 50px;">
                    <strong style="font-size: 11px;">Received by:</strong><br>
                    <span style="font-size: 9px;">Name & Signature</span>
                </td>
                <td style="border: 1px solid #000; padding: 4px; width: 25%; vertical-align: top; height: 50px;">
                    <strong style="font-size: 11px;">Date Received:</strong><br>
                    <span style="font-size: 9px;"></span>
                </td>
                <td style="border: 1px solid #000; padding: 4px; width: 25%; vertical-align: top; height: 50px;">
                    <strong style="font-size: 11px;">BL NO:</strong><br>
                    <span style="font-size: 9px;"></span>
                </td>
            </tr>
            <tr>
                <td colspan="2" style="border: 1px solid #000; padding: 4px; vertical-align: top; height: 50px;">
                    <strong style="font-size: 11px;">Approved by:</strong><br>
                    <span style="font-size: 9px;">Name & Signature</span>
                </td>
                <td colspan="2" style="border: 1px solid #000; padding: 4px; vertical-align: top; height: 50px;">
                    <strong style="font-size: 11px;">Driver's Printed Name and Signature:</strong><br>
                    <span style="font-size: 9px;"></span>
                </td>
            </tr>
        </table>
    </div>
</div>

@code {
    [Parameter]
    public PpeIssuanceModel Model { get; set; } = new();
}
