@page "/inventories/reports/par-list"
@using AMIS.Blazor.Infrastructure.Api
@attribute [Authorize(Policy = "View PropertyAcknowledgementReceipt")]

<PageTitle>Property Acknowledgement Receipt (PAR) List</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4">
        <MudGrid>
            <MudItem xs="12">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h5">Property Acknowledgement Receipt (PAR)</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                        Href="/inventories/reports/par">
                        Create New PAR
                    </MudButton>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_searchString" Label="Search" Variant="Variant.Outlined"
                    Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="500"
                    OnDebounceIntervalElapsed="@(() => _table?.ReloadServerData())" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined" T="int?" Clearable
                    OnClearButtonClick="@(() => { _statusFilter = null; _table?.ReloadServerData(); })">
                    <MudSelectItem Value="@((int?)0)">Draft</MudSelectItem>
                    <MudSelectItem Value="@((int?)1)">Posted</MudSelectItem>
                    <MudSelectItem Value="@((int?)2)">Returned</MudSelectItem>
                    <MudSelectItem Value="@((int?)3)">Cancelled</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDateRangePicker @bind-DateRange="_dateRange" Label="Date Range" Variant="Variant.Outlined" Clearable
                    OnClearButtonClick="@(() => { _dateRange = null; _table?.ReloadServerData(); })" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="ClearFilters">
                    Clear Filters
                </MudButton>
            </MudItem>

            <MudItem xs="12">
                <MudTable T="PARListItemDto" @ref="_table"
                    ServerData="@(new Func<TableState, CancellationToken, Task<TableData<PARListItemDto>>>(LoadDataAsync))"
                    Hover="true" Striped="true" Dense="true" Loading="@_loading" LoadingProgressColor="Color.Primary">
                    <HeaderContent>
                        <MudTh>PAR Number</MudTh>
                        <MudTh>Employee</MudTh>
                        <MudTh>Department</MudTh>
                        <MudTh>Issuance Date</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Items Count</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="PAR Number">@context.PARNumber</MudTd>
                        <MudTd DataLabel="Employee">@context.EmployeeName</MudTd>
                        <MudTd DataLabel="Department">@context.Department</MudTd>
                        <MudTd DataLabel="Issuance Date">@context.IssuanceDate.ToString("MM/dd/yyyy")</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">
                                @context.Status
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Items Count">@context.ItemsCount</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Info"
                                Href="@($"/inventories/reports/par/{context.Id}")" Title="View" />
                            @if (context.Status?.Equals("Draft", StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                    Href="@($"/inventories/reports/par/{context.Id}")" Title="Edit" />
                                <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" Color="Color.Success"
                                    OnClick="@(() => PostPAR(context.Id))" Title="Post" />
                            }
                            @if (context.Status?.Equals("Posted", StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardReturn" Size="Size.Small"
                                    Color="Color.Warning" OnClick="@(() => ReturnPAR(context.Id, context.PARNumber))"
                                    Title="Return Items" />
                            }
                            @if (context.Status?.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) != true)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Print" Size="Size.Small" Color="Color.Default"
                                    Href="@($"/inventories/reports/par-print/{context.Id}")" Title="Print" />
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>No PAR records found</MudText>
                    </NoRecordsContent>
                    <LoadingContent>
                        <MudText>Loading...</MudText>
                    </LoadingContent>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>