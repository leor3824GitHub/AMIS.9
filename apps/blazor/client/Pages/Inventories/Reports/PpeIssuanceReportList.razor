    private void CreateNewReport()
    {
        // Navigate to the PPEIR page without an ID to create a new report
        NavigationManager.NavigateTo("/inventories/reports/ppeir");
    }

    private void OpenNewReportDialog()
    {
        _formDialog?.Open();
    }

    private async Task OnReportSaved()
