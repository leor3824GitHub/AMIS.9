    {
        NavigationManager.NavigateTo($"/inventories/reports/ppeir?id={id}");
    }

    private async Task PrintReport(Guid id)
    {
        NavigationManager.NavigateTo($"/inventories/reports/ppeir-print?id={id}");
    }

