@page "/inventories/reports/ppeir-list"
@using AMIS.Blazor.Infrastructure.Api
@inject IAuthorizationService AuthService
@inject NavigationManager NavigationManager

<PageHeader Title="PPEIR List" Header="PPE Issuance Reports" SubHeader="View and manage PPE Issuance Reports" />

<MudPaper Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateNewReport"
                StartIcon="@Icons.Material.Filled.Add" Disabled="!_canCreate">New Report</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="LoadReports"
                StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>
        </MudStack>

        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_reports == null || _reports.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                No PPE Issuance Reports found. <MudLink OnClick="CreateNewReport" style="cursor: pointer;">
                    Create one now</MudLink>
            </MudAlert>
        }
        else
        {
            <MudTable Items="@_reports" Dense="true" Hover="true" Striped="true" Bordered="true">
                <HeaderContent>
                    <MudTh>Report Number</MudTh>
                    <MudTh>Recipient</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Issuance Date</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh align="center">Items</MudTh>
                    <MudTh>Created Date</MudTh>
                    <MudTh align="center">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Report Number">@context.ReportNumber</MudTd>
                    <MudTd DataLabel="Recipient">@context.RecipientName</MudTd>
                    <MudTd DataLabel="Type">@context.IssuanceType</MudTd>
                    <MudTd DataLabel="Issuance Date">@context.IssuanceDate.ToString("MMM dd, yyyy")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled"
                            Size="Size.Small">
                            @GetStatusText(context.Status)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Items" align="center">
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                            @context.LineItemsCount</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Created Date">@context.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</MudTd>
                    <MudTd align="center">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info"
                            OnClick="@(() => ViewDetails(context.Id))" Title="View Details" />
                        @if (context.Status == 0)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                OnClick="@(() => EditReport(context.Id))" Title="Edit" Disabled="!_canUpdate" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Info"
                            OnClick="@(() => PrintReport(context.Id))" Title="Print" />
                        @if (context.Status == 0)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Lock" Color="Color.Warning"
                                OnClick="@(() => PostReport(context.Id))" Title="Post" Disabled="!_canPost" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
</MudPaper>

@code {
    private const string ApiVersion = "1";
    [Inject] public IApiClient ApiClient { get; set; } = default!;
    [Inject] public ISnackbar Snackbar { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<PpeIssuanceReportDto> _reports = [];
    private bool _isLoading;
    private bool _canCreate;
    private bool _canUpdate;
    private bool _canPost;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _canCreate = await AuthService.HasPermissionAsync(user, FshActions.Create, FshResources.PpeIssuance);
        _canUpdate = await AuthService.HasPermissionAsync(user, FshActions.Update, FshResources.PpeIssuance);
        _canPost = await AuthService.HasPermissionAsync(user, FshActions.Post, FshResources.PpeIssuance);
        await LoadReports();
    }

    private async Task LoadReports()
    {
        _isLoading = true;
        try
        {
            var response = await ApiClient.ListPpeIssuanceReportsEndpointAsync(ApiVersion);
            _reports = response.Reports?.ToList() ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading reports: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void CreateNewReport()
    {
        // Navigate to the PPEIR page without an ID to create a new report
        NavigationManager.NavigateTo("/inventories/reports/ppeir");
    }

    private void ViewDetails(Guid id)
    {
        NavigationManager.NavigateTo($"/inventories/reports/ppeir/{id}?readonly=true");
    }

    private void EditReport(Guid id)
    {
        NavigationManager.NavigateTo($"/inventories/reports/ppeir/{id}");
    }

    private void PrintReport(Guid id)
    {
        NavigationManager.NavigateTo($"/inventories/reports/ppeir/{id}?readonly=true&print=true");
    }

    private async Task PostReport(Guid id)
    {
        try
        {
            await ApiClient.PostPpeIssuanceReportEndpointAsync(ApiVersion, id);
            Snackbar.Add("PPE Issuance Report posted successfully", Severity.Success);
            await LoadReports();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error posting report: {ex.Message}", Severity.Error);
        }
    }

    private string GetStatusText(int status)
    {
        return status switch
        {
            0 => "Draft",
            1 => "Posted",
            _ => $"Unknown ({status})"
        };
    }

    private Color GetStatusColor(int status)
    {
        return status switch
        {
            0 => Color.Warning, // Draft
            1 => Color.Success, // Posted
            _ => Color.Default
        };
    }

    // Using PpeIssuanceReportDto generated by NSwag in AMIS.Blazor.Infrastructure.Api
}