@page "/inventories/reports/ppeir"
@page "/inventories/reports/ppeir/{ReportId}"
@using AMIS.Blazor.Client.Components
@using AMIS.Blazor.Infrastructure.Api
@using System.ComponentModel.DataAnnotations

<PageHeader Title="PPE Issuance Report" Header="PPE Issuance Report" SubHeader="Issue PPE items from inventory" />

@* TODO: Uncomment when API client is regenerated with Get and Update endpoints *@
