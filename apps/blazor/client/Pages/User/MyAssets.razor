@page "/my-accountability/my-assets"
@using AMIS.Blazor.Infrastructure.Api
@using Microsoft.AspNetCore.Components.Authorization

<PageHeader Title="My Assets" Description="View assets in your custody" />

<AuthorizeView>
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-8">
            <MudGrid>
                <MudItem xs="12">
                    <MudPaper Elevation="2" Class="pa-6">
                        <MudText Typo="Typo.h6" GutterBottom="true">Assets in Custody</MudText>

                        <MudStack Row="true" Spacing="2" Class="mb-4">
                            <MudTextField @bind-Value="@_searchTerm"
                                Placeholder="Search by asset name or property code..." Variant="Variant.Outlined"
                                FullWidth="true" Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.Search" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAssets">Search
                            </MudButton>
                        </MudStack>

                        @if (_assets == null)
                        {
                            <MudProgressLinear Indeterminate="true" />
                        }
                        else if (_assets.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">No assets assigned to you.</MudAlert>
                        }
                        else
                        {
                            <MudDataGrid Items="@_assets" Hover="true" Striped="true" Elevation="0" Class="mt-4">
                                <Columns>
                                    <PropertyColumn Property="x => x.PropertyCode" Title="Property Code"
                                        CellStyle="width:150px;" />
                                    <PropertyColumn Property="x => x.AssetName" Title="Asset Name"
                                        CellStyle="width:250px;" />
                                    <PropertyColumn Property="x => x.Category" Title="Category" CellStyle="width:150px;" />
                                    <PropertyColumn Property="x => x.AcquisitionCost" Title="Acquisition Cost"
                                        CellStyle="width:150px;">
                                        <CellTemplate Context="assetItem">
                                            <MudText>₱ @assetItem.Item.AcquisitionCost?.ToString("N2")</MudText>
                                        </CellTemplate>
                                    </PropertyColumn>
                                    <PropertyColumn Property="x => x.Condition" Title="Condition" CellStyle="width:120px;">
                                        <CellTemplate Context="assetItem">
                                            <MudChip T="string" Color="@GetConditionColor(assetItem.Item.Condition)"
                                                Size="Size.Small" Variant="Variant.Text">
                                                @assetItem.Item.Condition
                                            </MudChip>
                                        </CellTemplate>
                                    </PropertyColumn>
                                    <PropertyColumn Property="x => x.DateAssigned" Title="Date Assigned"
                                        CellStyle="width:150px;">
                                        <CellTemplate Context="assetItem">
                                            <MudText Typo="Typo.body2">@assetItem.Item.DateAssigned?.ToString("MMM dd,                                            yyyy")</MudText>
                                        </CellTemplate>
                                    </PropertyColumn>
                                    <TemplateColumn Title="Actions" CellStyle="width:200px;">
                                        <CellTemplate Context="assetItem">
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                OnClick="@(() => ViewDetails(assetItem.Item))">
                                                Details
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                                OnClick="@(() => OpenIssueDialog(assetItem.Item))">
                                                Issue
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                                OnClick="@(() => OpenReturnDialog(assetItem.Item))">
                                                Return
                                            </MudButton>
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>
                        }
                    </MudPaper>
                </MudItem>

                <!-- Asset Summary Cards -->
                <MudItem xs="12" sm="6" md="3">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" Color="Color.Default">Total Assets</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Primary">@_assets?.Count</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" Color="Color.Default">Total Value</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success">
                                ₱ @(_assets?.Sum(a => a.AcquisitionCost ?? 0).ToString("N0") ?? "0")
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" Color="Color.Default">Good Condition</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Info">
                                @(_assets?.Count(a => a.Condition == "Good") ?? 0)
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudCard>
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle2" Color="Color.Default">Needs Repair</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Warning">
                                @(_assets?.Count(a => a.Condition == "For Repair") ?? 0)
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-8">
            <MudAlert Severity="Severity.Warning">Please log in to view your assets.</MudAlert>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

<!-- Asset Details Dialog -->
<MudDialog @bind-IsOpen="@_showDetailsDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
            Asset Details
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedAsset != null)
        {
            <MudCard Elevation="0" Outlined="true" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@_selectedAsset.AssetName</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_selectedAsset.PropertyCode</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudChip T="string" Color="@GetConditionColor(_selectedAsset.Condition)" Size="Size.Small">
                            @_selectedAsset.Condition
                        </MudChip>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Category</MudText>
                            <MudText Typo="Typo.body1">@_selectedAsset.Category</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Acquisition Cost</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Success">₱ @_selectedAsset.AcquisitionCost?.ToString("N2")</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Date Assigned</MudText>
                            <MudText Typo="Typo.body1">@_selectedAsset.DateAssigned?.ToString("MMM dd, yyyy")</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Days in Custody</MudText>
                            <MudText Typo="Typo.body1">@GetDaysInCustody(_selectedAsset.DateAssigned) days</MudText>
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-4" />

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Description</MudText>
                    <MudText Typo="Typo.body2">
                        This asset is currently assigned to you. Please ensure it is properly maintained and used according to company policies.
                    </MudText>
                </MudCardContent>
            </MudCard>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDetailsDialog = false)">Close</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="@(() => { _showDetailsDialog = false; OpenReturnDialog(_selectedAsset!); })">
            Return Asset
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Asset Return Dialog -->
<MudDialog @bind-IsOpen="@_showReturnDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.AssignmentReturn" Class="mr-2" />
            Return Asset
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedAsset != null)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                You are returning <strong>@_selectedAsset.AssetName</strong> (@_selectedAsset.PropertyCode)
            </MudAlert>

            <MudSelect @bind-Value="_returnCondition" Label="Asset Condition *" Variant="Variant.Outlined" FullWidth="true"
                AdornmentIcon="@Icons.Material.Filled.HealthAndSafety" Adornment="Adornment.Start" Required="true">
                <MudSelectItem Value="@("Good")">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-2" />
                        Good - No issues
                    </div>
                </MudSelectItem>
                <MudSelectItem Value="@("Fair")">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                        Fair - Minor wear and tear
                    </div>
                </MudSelectItem>
                <MudSelectItem Value="@("For Repair")">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Error" Size="Size.Small" Class="mr-2" />
                        For Repair - Requires maintenance
                    </div>
                </MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="_returnNotes" Label="Return Notes" Variant="Variant.Outlined" FullWidth="true"
                Lines="4" Class="mt-4" Placeholder="Describe any issues, damages, or observations about the asset..."
                HelperText="Please provide details if condition is Fair or For Repair" />

            <MudCheckBox @bind-Value="_confirmReturn" Color="Color.Primary" Class="mt-4">
                I confirm that I am returning this asset in the stated condition
            </MudCheckBox>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showReturnDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="@SubmitReturn" Disabled="@(!_confirmReturn)">
            <MudIcon Icon="@Icons.Material.Filled.AssignmentReturn" Class="mr-1" />
            Return Asset
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Asset Issue Dialog -->
<MudDialog @bind-IsOpen="@_showIssueDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="mr-2" />
            Issue Asset to Another Employee
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedAsset != null)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
                Transferring custody of <strong>@_selectedAsset.AssetName</strong> (@_selectedAsset.PropertyCode)
            </MudAlert>

            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Employee Information</MudText>
                </MudItem>
                
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_issueEmployeeId" Label="Employee ID *" Variant="Variant.Outlined" 
                        FullWidth="true" Required="true"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge"
                        HelperText="Enter the employee ID or GUID"
                        @onblur="ValidateEmployeeId" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_issueEmployeeName" Label="Employee Name *" Variant="Variant.Outlined" 
                        FullWidth="true" Required="true"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                        HelperText="Full name of the receiving employee" />
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Transfer Details</MudText>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_issueDocumentNumber" Label="Document/Reference Number" 
                        Variant="Variant.Outlined" FullWidth="true"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Description"
                        HelperText="Optional transfer document reference" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_issueDate" Label="Transfer Date" Variant="Variant.Outlined" 
                        FullWidth="true" DisableFuture="true"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.CalendarToday" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_issueNotes" Label="Transfer Notes" Variant="Variant.Outlined" 
                        FullWidth="true" Lines="3"
                        Placeholder="Reason for transfer, project assignment, etc..."
                        HelperText="Document the reason for this asset transfer" />
                </MudItem>

                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_confirmIssue" Color="Color.Primary">
                        I confirm that I am transferring custody of this asset to the specified employee
                    </MudCheckBox>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showIssueDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="@SubmitIssue" 
            Disabled="@(!CanSubmitIssue())">
            <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-1" />
            Transfer Asset
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<AssetViewModel> _assets = new();
    private AssetViewModel? _selectedAsset;
    private bool _showDetailsDialog = false;
    private bool _showReturnDialog = false;
    private bool _showIssueDialog = false;
    private string _returnCondition = "Good";
    private string _returnNotes = string.Empty;
    private string _issueEmployeeName = string.Empty;
    private string _issueEmployeeId = string.Empty;
    private string _issueDocumentNumber = string.Empty;
    private DateTime? _issueDate = DateTime.Today;
    private string _issueNotes = string.Empty;
    private bool _confirmReturn = false;
    private bool _confirmIssue = false;
    private string _searchTerm = string.Empty;

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Dashboard", href: "/dashboard"),
        new BreadcrumbItem("My Assets", href: null, disabled: true)
    };
}
