@code {
    [Parameter]
    public ICollection<PurchaseRequestItemCreateDto> Items { get; set; } = new
    List<PurchaseRequestItemCreateDto>();
    [Parameter] public IReadOnlyList<ProductResponse> Products { get; set; } = Array.Empty<ProductResponse>();
    [Parameter] public Action? OnItemsChanged { get; set; }

    [Inject] protected ISnackbar Snackbar { get; set; } = default!;

    private PurchaseRequestItemCreateDto? EditingItem { get; set; }

    private string? NewProductText { get; set; }
    private int NewQty { get; set; }
    private string? NewUnit { get; set; } = "Piece";
    private string? NewDescription { get; set; }


    private readonly string[] UnitOptions = new[]
    {
"Piece", "Box", "Pack", "Set", "Unit",
"Liter", "Gallon", "Milliliter",
"Kilogram", "Gram", "Pound", "Ounce",
"Meter", "Centimeter", "Foot", "Inch",
"Square Meter", "Square Foot",
"Cubic Meter", "Cubic Foot",
"Dozen", "Gross", "Ream"
};

    protected override void OnParametersSet()
    {
        // Keep client DTOs consistent with NSwag-generated non-nullable strings.
        foreach (var item in Items)
        {
            item.ManualProductName ??= string.Empty;
            item.Unit ??= "Piece";
            item.Description ??= string.Empty;
        }
    }

    private static bool IsManual(PurchaseRequestItemCreateDto item)
        => item.ProductId is null;

    private string GetProductText(PurchaseRequestItemCreateDto item)
    {
        if (item.ProductId is not null)
        {
            return Products.FirstOrDefault(x => x.Id == item.ProductId)?.Name ?? string.Empty;
        }

        return item.ManualProductName ?? string.Empty;
    }

    private void SetProductFromText(PurchaseRequestItemCreateDto item, string? text)
    {
        var normalized = (text ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(normalized))
        {
            item.ProductId = null;
            item.ManualProductName = string.Empty;
            OnItemsChanged?.Invoke();
            return;
        }

        var matched = Products.FirstOrDefault(p => string.Equals(p.Name, normalized, StringComparison.OrdinalIgnoreCase));
        if (matched is not null)
        {
            item.ProductId = matched.Id;
            item.ManualProductName = string.Empty;
        }
        else
        {
            item.ProductId = null;
            item.ManualProductName = normalized;
        }

        OnItemsChanged?.Invoke();
    }

    private Task<IEnumerable<string>> SearchProductNames(string value, CancellationToken cancellationToken)
    {
        IEnumerable<string> results = Products.Select(p => p.Name);

        if (!string.IsNullOrWhiteSpace(value))
        {
            results = results.Where(n => n.Contains(value, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(results);
    }

    private string GetProductLabel(Guid? productId, string? manualProductName)
    {
        if (productId is not null)
        {
            return Products.FirstOrDefault(x => x.Id == productId)?.Name ?? "";
        }

        var manual = manualProductName ?? string.Empty;
        if (string.IsNullOrWhiteSpace(manual)) return "";
        return manual;
    }

    private void EditItem(PurchaseRequestItemCreateDto item)
    {
        item.ManualProductName ??= string.Empty;
        item.Description ??= string.Empty;
        item.Unit ??= "Piece";
        EditingItem = item;
    }

    private void SaveEdit()
    {
        if (EditingItem is null) return;
        if (!ValidateItem(EditingItem)) return;
        EditingItem = null;
        OnItemsChanged?.Invoke();
    }

    private void CancelEdit() => EditingItem = null;

    private void AddItem()
    {
        var normalized = (NewProductText ?? string.Empty).Trim();
        var matched = !string.IsNullOrWhiteSpace(normalized)
            ? Products.FirstOrDefault(p => string.Equals(p.Name, normalized, StringComparison.OrdinalIgnoreCase))
            : null;

        var newItem = new PurchaseRequestItemCreateDto
        {
            ProductId = matched?.Id,
            ManualProductName = matched is null ? normalized : string.Empty,
            Qty = NewQty,
            Unit = NewUnit ?? string.Empty,
            Description = NewDescription ?? string.Empty
        };

        if (!ValidateItem(newItem)) return;

        Items.Add(newItem);
        NewProductText = null;
        NewQty = 0;
        NewUnit = "Piece";
        NewDescription = null;
        OnItemsChanged?.Invoke();
    }

    private bool ValidateItem(PurchaseRequestItemCreateDto item)
    {
        var hasProduct = item.ProductId is not null;
        var hasManual = !string.IsNullOrWhiteSpace(item.ManualProductName);

        if (!hasProduct && !hasManual)
        {
            Snackbar.Add("Product is required. Type a product name or pick one from the list.", Severity.Error);
            return false;
        }

        if (hasProduct && hasManual)
        {
            Snackbar.Add("Choose a catalog product OR type a manual product name (not both).", Severity.Error);
            return false;
        }

        if (item.Qty <= 0)
        {
            Snackbar.Add("Quantity must be greater than zero.", Severity.Error);
            return false;
        }

        if (string.IsNullOrWhiteSpace(item.Unit))
        {
            Snackbar.Add("Unit is required.", Severity.Error);
            return false;
        }

        return true;
    }

    private void RemoveItem(PurchaseRequestItemCreateDto item)
    {
        Items.Remove(item);
        OnItemsChanged?.Invoke();
    }
}