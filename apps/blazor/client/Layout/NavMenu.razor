@using MudBlazor
@using AMIS.Blazor.Client.Components

<PersonCard
    Style="background-color: var(--mud-palette-drawer-background);color: var(--mud-palette-drawer-text); margin-bottom:0px!important" />
<MudNavMenu>
    <MudText Typo="Typo.subtitle2" Color="Color.Surface" Class="ml-4 my-3">Start</MudText>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="/dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">Dashboard
    </MudNavLink>
    @* <MudNavLink Href="counter" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Add">Counter</MudNavLink> *@
    @if (_canViewAuditTrails)
    {
        <MudNavLink Match="NavLinkMatch.Prefix" Href="/identity/audit-trail" Icon="@Icons.Material.Filled.WorkHistory">Audit
            Trail</MudNavLink>
    }
    <MudText Typo="Typo.subtitle2" Color="Color.Surface" Class="ml-4 my-3">Modules</MudText>
    <MudNavGroup Title="Inventories" Icon="@Icons.Material.Filled.AddBox">
        @if (_canViewPhysicalAssets)
        {
            <MudNavLink Href="/inventories/physical-assets" Icon="@Icons.Material.Filled.Domain" Class="fsh-nav-child">
                Physical Assets
            </MudNavLink>
        }
        @if (_canViewPurchases)
        {
            <MudNavLink Href="/inventories/purchases" Icon="@Icons.Material.Filled.ShoppingCart" Class="fsh-nav-child">
                Purchases
            </MudNavLink>
        }
        @if (_canViewPurchaseRequests)
        {
            <MudNavLink Href="/inventories/purchaserequests" Icon="@Icons.Material.Filled.Description"
                Class="fsh-nav-child">
                Purchase Requests</MudNavLink>
        }
        @if (_canViewCanvasses)
        {
            <MudNavLink Href="/inventories/canvasses" Icon="@Icons.Material.Filled.Gavel" Class="fsh-nav-child">Canvasses
            </MudNavLink>
        }
        @if (_canViewProcurementPlans)
        {
            <MudNavLink Href="/inventories/procurementplans" Icon="@Icons.Material.Filled.Assignment" Class="fsh-nav-child">
                PPMP
            </MudNavLink>
        }
        @if (_canViewAnnualProcurementPlans)
        {
            <MudNavLink Href="/inventories/annualprocurementplans" Icon="@Icons.Material.Filled.CalendarMonth"
                Class="fsh-nav-child">APP</MudNavLink>
        }
        @if (_canViewInspectionRequests)
        {
            <MudNavLink Href="/inventories/inspectionrequests" Icon="@Icons.Material.Filled.ShoppingCart"
                Class="fsh-nav-child">
                Inspection Request</MudNavLink>
        }
        @if (_canViewInspections)
        {
            <MudNavLink Href="/inventories/inspections" Icon="@Icons.Material.Filled.ShoppingCart" Class="fsh-nav-child">
                Inspections</MudNavLink>
        }
        @if (_canViewIssuances)
        {
            <MudNavLink Href="/inventories/issuances" Icon="@Icons.Material.Filled.LocalShipping" Class="fsh-nav-child">
                Issuances</MudNavLink>
        }
        @if (_canViewIssuances)
        {
            <MudNavLink Href="/inventories/asset-issuance" Icon="@Icons.Material.Filled.QrCode2" Class="fsh-nav-child">
                Asset Issuance (ICS)</MudNavLink>
        }
        <!-- @if (_canViewSmir)
        {
                <MudNavLink Href="/inventories/reports/smir" Icon="@Icons.Material.Filled.Assignment" Class="fsh-nav-child">
                    SMIR</MudNavLink>
        }
        @if (_canViewSmrr)
        {
                <MudNavLink Href="/inventories/reports/smrr" Icon="@Icons.Material.Filled.ReceiptLong" Class="fsh-nav-child">
                    SMRR</MudNavLink>
        }
 -->
        @if (_canViewPpeIssuanceReports)
        {
            <MudNavLink Href="/inventories/reports/ppeir-list" Icon="@Icons.Material.Filled.Send" Class="fsh-nav-child">
                PPE Issuance Reports</MudNavLink>
        }
        @if (_canViewPpeReceivingReports)
        {
            <MudNavLink Href="/inventories/reports/pper-list" Icon="@Icons.Material.Filled.Inbox" Class="fsh-nav-child">
                PPE Receiving Report</MudNavLink>
        }
        @if (_canViewPropertyAcknowledgementReceipt)
        {
            <MudNavLink Href="/inventories/reports/par-list" Icon="@Icons.Material.Filled.Assignment" Class="fsh-nav-child">
                Property Acknowledgement Receipt (PAR)</MudNavLink>
        }
        @if (_canViewSmrr)
        {
            <MudNavLink Href="/inventories/reports/smrr-list" Icon="@Icons.Material.Filled.MoveToInbox"
                Class="fsh-nav-child">
                Supplies & Materials Receiving</MudNavLink>
        }
        @if (_canViewSmir)
        {
            <MudNavLink Href="/inventories/reports/smir-list" Icon="@Icons.Material.Filled.SendToMobile"
                Class="fsh-nav-child">
                Supplies & Materials Issuance</MudNavLink>
        }
        @if (_canViewInventories)
        {
            <MudNavLink Href="/inventories/inventories" Icon="@Icons.Material.Filled.Inventory2" Class="fsh-nav-child">
                Inventories</MudNavLink>
        }

        @if (_canViewAcceptances)
        {
            <MudNavLink Href="/inventories/acceptances" Icon="@Icons.Material.Filled.AssignmentTurnedIn"
                Class="fsh-nav-child">
                Acceptances</MudNavLink>
        }
        @* Registry *@
        @if (_canViewProducts || _canViewCategories || _canViewSuppliers || _canViewEmployees)
        {
            <MudNavGroup Title="Registry" Icon="@Icons.Material.Filled.ListAlt">
                @if (_canViewProducts)
                {
                    <MudNavLink Href="/inventories/products" Icon="@Icons.Material.Filled.List" Class="fsh-nav-child">Products
                    </MudNavLink>
                }
                @if (_canViewPropertyCodeSequences)
                {
                    <MudNavLink Href="/inventories/property-code-sequences" Icon="@Icons.Material.Filled.Settings" Class="fsh-nav-child">
                        Property Code
                    </MudNavLink>
                }
                @if (_canViewCategories)
                {
                    <MudNavLink Href="/inventories/categories" Icon="@Icons.Material.Filled.Label" Class="fsh-nav-child">Categories
                    </MudNavLink>
                }
                @if (_canViewSuppliers)
                {
                    <MudNavLink Href="/inventories/suppliers" Icon="@Icons.Material.Filled.Label" Class="fsh-nav-child">Suppliers
                    </MudNavLink>
                }
                @if (_canViewEmployees)
                {
                    <MudNavLink Href="/inventories/employees" Icon="@Icons.Material.Filled.Label" Class="fsh-nav-child">Employees
                    </MudNavLink>
                }
            </MudNavGroup>
        }
    </MudNavGroup>
    <MudNavLink Href="/todos" Icon="@Icons.Material.Filled.Checklist" Class="fsh-nav-child">Todos</MudNavLink>

    @if (CanViewAccountingGroup)
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Surface" Class="ml-4 my-3">Accounting</MudText>
        @if (_canViewDepreciationSchedules)
        {
            <MudNavLink Href="/accounting/depreciation" Icon="@Icons.Material.Filled.TrendingDown" Class="fsh-nav-child">
                Depreciation</MudNavLink>
        }
        @if (_canViewJournalEntryVouchers)
        {
            <MudNavLink Href="/accounting/jev-export" Icon="@Icons.Material.Filled.Receipt" Class="fsh-nav-child">
                Journal Entry Vouchers</MudNavLink>
        }
    }

    @if (CanViewMyAccountabilityGroup)
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Surface" Class="ml-4 my-3">My Accountability</MudText>
        @if (_canViewAssetRequisitions)
        {
            <MudNavLink Href="/my-accountability/pending-actions" Match="NavLinkMatch.Prefix"
                Icon="@Icons.Material.Filled.PendingActions" Class="fsh-nav-child">
                Pending Actions</MudNavLink>
        }
        @if (_canViewPhysicalAssets)
        {
            <MudNavLink Href="/my-accountability/my-assets" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBox"
                Class="fsh-nav-child">
                My Assets</MudNavLink>
        }
    }

    @if (CanViewAdministrationGroup)
    {
        <MudText Typo="Typo.subtitle2" Color="Color.Surface" Class="ml-4 my-3">Administration</MudText>
        @if (_canViewUsers)
        {
            <MudNavLink Match="NavLinkMatch.Prefix" Href="/identity/users" Icon="@Icons.Material.Filled.PeopleAlt">Users
            </MudNavLink>
        }
        @if (_canViewRoles)
        {
            <MudNavLink Href="/identity/roles" Icon="@Icons.Material.Filled.EmojiPeople">Roles</MudNavLink>
        }
        @if (_canViewTenants)
        {
            <MudNavLink Href="/tenants" Icon="@Icons.Material.Filled.GroupWork" Disabled="!_canViewTenants">Tenants</MudNavLink>
        }
    }
</MudNavMenu>